        "import pandas as pd\n",
        "\n",
        "final_meg_df = pd.read_csv('/content/drive/MyDrive/final_meg-passive(par)_top7_rfc+shap_10-fold_analysis_last_column.csv')\n",
        "\n",
        "print(\"Loaded data shape:\", final_meg_df.shape)\n",
        "print(final_meg_df.head())\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "mYHTqtxkEZFX",
        "outputId": "de6e05c4-0cc9-444d-e354-666b0918e24d"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Loaded data shape: (127, 8)\n",
            "   env_kurt_asym  burst_amp_cv_asym  env_kurt_R_mean  env_mod_rate_L_std  \\\n",
            "0      -0.076816           0.013925         2.510726            0.296017   \n",
            "1      -0.053170          -0.011675         2.189911            0.076190   \n",
            "2       0.073234           0.010955         1.217854            0.413152   \n",
            "3       0.077393           0.027533         1.394646            0.467633   \n",
            "4       0.022059           0.005688         1.268945            0.309523   \n",
            "\n",
            "   env_mod_rate_R_std  mean_burst_duration_R_std  env_mod_rate_R_mean  \\\n",
            "0            0.312178                   0.002180             0.421821   \n",
            "1            0.063898                   0.012065             0.208876   \n",
            "2            0.278854                   0.001874             0.462511   \n",
            "3            0.511813                   0.003089             0.637478   \n",
            "4            0.341810                   0.004726             0.295681   \n",
            "\n",
            "   PD_Label_Combined  \n",
            "0                  0  \n",
            "1                  0  \n",
            "2                  0  \n",
            "3                  1  \n",
            "4                  1  \n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "#           BASELINE SUPERVISED CONTRASTIVE LEARNING\n",
        "#        (BASIC SCL BASELINE + 5-FOLD CROSS VALIDATION)\n",
        "# ============================================================\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "\n",
        "import torch.nn.functional as F\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score\n",
        ")\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# ============================================================\n",
        "# LOAD DATA\n",
        "# ============================================================\n",
        "\n",
        "sc = StandardScaler()\n",
        "\n",
        "# Acoustic\n",
        "X_acoustic = sc.fit_transform(\n",
        "    df_acoustic_top7.iloc[:, :-1]\n",
        ").astype(np.float32)\n",
        "\n",
        "# MEG\n",
        "X_meg = sc.fit_transform(\n",
        "    final_meg_df.iloc[:, :-1]\n",
        ").astype(np.float32)\n",
        "\n",
        "# LABELS\n",
        "\n",
        "acoustic_labels = df_acoustic_top7.iloc[:, -1].values.astype(np.int64)\n",
        "\n",
        "meg_labels = final_meg_df.iloc[:, -1].values.astype(np.int64)\n",
        "\n",
        "# ============================================================\n",
        "# COMBINE MODALITIES\n",
        "# ============================================================\n",
        "\n",
        "X_all = np.vstack([\n",
        "    X_acoustic,\n",
        "    X_meg\n",
        "]).astype(np.float32)\n",
        "\n",
        "task_labels = np.hstack([\n",
        "    acoustic_labels,\n",
        "    meg_labels\n",
        "]).astype(np.int64)\n",
        "\n",
        "# ============================================================\n",
        "# TENSORS\n",
        "# ============================================================\n",
        "\n",
        "X_all_tensor = torch.tensor(\n",
        "    X_all\n",
        ").float().to(device)\n",
        "\n",
        "task_labels_tensor = torch.tensor(\n",
        "    task_labels\n",
        ").long().to(device)\n",
        "\n",
        "# ============================================================\n",
        "# SIMPLE SCL MODEL\n",
        "# ============================================================\n",
        "\n",
        "class BasicSCLModel(nn.Module):\n",
        "\n",
        "    def __init__(self, input_dim, latent_dim=32):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        # SIMPLE ENCODER\n",
        "\n",
        "        self.encoder = nn.Sequential(\n",
        "\n",
        "            nn.Linear(input_dim, 64),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(64, latent_dim)\n",
        "        )\n",
        "\n",
        "        # SIMPLE TASK HEAD\n",
        "\n",
        "        self.task_head = nn.Sequential(\n",
        "\n",
        "            nn.Linear(latent_dim, 16),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(16, 2)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        # LATENT FEATURES\n",
        "\n",
        "        z = self.encoder(x)\n",
        "\n",
        "        # NORMALIZATION\n",
        "\n",
        "        z_norm = F.normalize(\n",
        "            z,\n",
        "            p=2,\n",
        "            dim=1\n",
        "        )\n",
        "\n",
        "        # CLASSIFICATION\n",
        "\n",
        "        task_out = self.task_head(z_norm)\n",
        "\n",
        "        return task_out, z_norm\n",
        "\n",
        "# ============================================================\n",
        "# BASIC SUPERVISED CONTRASTIVE LOSS\n",
        "# ============================================================\n",
        "\n",
        "class SupConLoss(nn.Module):\n",
        "\n",
        "    def __init__(self, temperature=0.1):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        self.temperature = temperature\n",
        "\n",
        "    def forward(self, features, labels):\n",
        "\n",
        "        device = features.device\n",
        "\n",
        "        labels = labels.contiguous().view(-1, 1)\n",
        "\n",
        "        mask = torch.eq(\n",
        "            labels,\n",
        "            labels.T\n",
        "        ).float().to(device)\n",
        "\n",
        "        similarity = torch.matmul(\n",
        "            features,\n",
        "            features.T\n",
        "        ) / self.temperature\n",
        "\n",
        "        logits_mask = torch.ones_like(mask) - torch.eye(\n",
        "            mask.shape[0]\n",
        "        ).to(device)\n",
        "\n",
        "        mask = mask * logits_mask\n",
        "\n",
        "        exp_sim = torch.exp(similarity) * logits_mask\n",
        "\n",
        "        log_prob = similarity - torch.log(\n",
        "            exp_sim.sum(1, keepdim=True) + 1e-8\n",
        "        )\n",
        "\n",
        "        mean_log_prob_pos = (\n",
        "            mask * log_prob\n",
        "        ).sum(1) / (mask.sum(1) + 1e-8)\n",
        "\n",
        "        loss = -mean_log_prob_pos.mean()\n",
        "\n",
        "        return loss\n",
        "\n",
        "# ============================================================\n",
        "# DATA LOADER\n",
        "# ============================================================\n",
        "\n",
        "dataset = TensorDataset(\n",
        "    X_all_tensor,\n",
        "    task_labels_tensor\n",
        ")\n",
        "\n",
        "loader = DataLoader(\n",
        "    dataset,\n",
        "    batch_size=128,\n",
        "    shuffle=True\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# MODEL\n",
        "# ============================================================\n",
        "\n",
        "model = BasicSCLModel(\n",
        "    input_dim=X_all.shape[1],\n",
        "    latent_dim=32\n",
        ").to(device)\n",
        "\n",
        "# ============================================================\n",
        "# OPTIMIZER\n",
        "# ============================================================\n",
        "\n",
        "optimizer = optim.Adam(\n",
        "    model.parameters(),\n",
        "    lr=1e-3\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# LOSSES\n",
        "# ============================================================\n",
        "\n",
        "task_loss_fn = nn.CrossEntropyLoss()\n",
        "\n",
        "contrastive_loss_fn = SupConLoss(\n",
        "    temperature=0.1\n",
        ")\n",
        "\n",
        "epochs = 120\n",
        "\n",
        "print(\"\\nTraining Started...\\n\")\n",
        "\n",
        "# ============================================================\n",
        "# TRAINING\n",
        "# ============================================================\n",
        "\n",
        "for epoch in range(epochs):\n",
        "\n",
        "    model.train()\n",
        "\n",
        "    total_correct = 0\n",
        "    total_samples = 0\n",
        "\n",
        "    for xb, y_task in loader:\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        # FORWARD\n",
        "\n",
        "        task_out, z = model(xb)\n",
        "\n",
        "        # TASK LOSS\n",
        "\n",
        "        loss_task = task_loss_fn(\n",
        "            task_out,\n",
        "            y_task\n",
        "        )\n",
        "\n",
        "        # CONTRASTIVE LOSS\n",
        "\n",
        "        loss_contrastive = contrastive_loss_fn(\n",
        "            z,\n",
        "            y_task\n",
        "        )\n",
        "\n",
        "        # FINAL LOSS\n",
        "\n",
        "        loss = (\n",
        "            1.0 * loss_task +\n",
        "            0.3 * loss_contrastive\n",
        "        )\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer.step()\n",
        "\n",
        "        # ACCURACY\n",
        "\n",
        "        preds = task_out.argmax(1)\n",
        "\n",
        "        total_correct += (\n",
        "            preds == y_task\n",
        "        ).sum().item()\n",
        "\n",
        "        total_samples += len(y_task)\n",
        "\n",
        "    acc = total_correct / total_samples\n",
        "\n",
        "    print(\n",
        "        f\"Epoch {epoch+1}/{epochs} \"\n",
        "        f\"| Accuracy={acc:.4f}\"\n",
        "    )\n",
        "\n",
        "# ============================================================\n",
        "# EXTRACT 32D LATENT FEATURES\n",
        "# ============================================================\n",
        "\n",
        "model.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    fused_acoustic_32D = model(\n",
        "        torch.tensor(X_acoustic).float().to(device)\n",
        "    )[1].cpu().numpy()\n",
        "\n",
        "    fused_meg_32D = model(\n",
        "        torch.tensor(X_meg).float().to(device)\n",
        "    )[1].cpu().numpy()\n",
        "\n",
        "# ============================================================\n",
        "# COMBINE LATENT FEATURES\n",
        "# ============================================================\n",
        "\n",
        "combined_32D = np.vstack([\n",
        "    fused_acoustic_32D,\n",
        "    fused_meg_32D\n",
        "]).astype(np.float32)\n",
        "\n",
        "combined_labels = np.hstack([\n",
        "    acoustic_labels,\n",
        "    meg_labels\n",
        "]).astype(np.int64)\n",
        "\n",
        "# ============================================================\n",
        "# FINAL MLP CLASSIFIER\n",
        "# ============================================================\n",
        "\n",
        "class FinalMLP(nn.Module):\n",
        "\n",
        "    def __init__(self, input_dim=32):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        self.net = nn.Sequential(\n",
        "\n",
        "            nn.Linear(input_dim, 64),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Dropout(0.2),\n",
        "\n",
        "            nn.Linear(64, 32),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(32, 2)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        return self.net(x)\n",
        "\n",
        "# ============================================================\n",
        "# 5-FOLD CROSS VALIDATION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" CROSS VALIDATION RESULTS\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "skf = StratifiedKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "accs = []\n",
        "precs = []\n",
        "recs = []\n",
        "f1s = []\n",
        "aucs = []\n",
        "\n",
        "fold = 1\n",
        "\n",
        "for train_idx, test_idx in skf.split(combined_32D, combined_labels):\n",
        "\n",
        "    X_train = torch.tensor(\n",
        "        combined_32D[train_idx]\n",
        "    ).float().to(device)\n",
        "\n",
        "    X_test = torch.tensor(\n",
        "        combined_32D[test_idx]\n",
        "    ).float().to(device)\n",
        "\n",
        "    y_train = torch.tensor(\n",
        "        combined_labels[train_idx]\n",
        "    ).long().to(device)\n",
        "\n",
        "    y_test = combined_labels[test_idx]\n",
        "\n",
        "    clf = FinalMLP().to(device)\n",
        "\n",
        "    optimizer_clf = optim.Adam(\n",
        "        clf.parameters(),\n",
        "        lr=1e-3\n",
        "    )\n",
        "\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    # ========================================================\n",
        "    # TRAIN CLASSIFIER\n",
        "    # ========================================================\n",
        "\n",
        "    clf.train()\n",
        "\n",
        "    for epoch in range(80):\n",
        "\n",
        "        optimizer_clf.zero_grad()\n",
        "\n",
        "        outputs = clf(X_train)\n",
        "\n",
        "        loss = criterion(\n",
        "            outputs,\n",
        "            y_train\n",
        "        )\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer_clf.step()\n",
        "\n",
        "    # ========================================================\n",
        "    # TEST\n",
        "    # ========================================================\n",
        "\n",
        "    clf.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        outputs = clf(X_test)\n",
        "\n",
        "        probs = F.softmax(\n",
        "            outputs,\n",
        "            dim=1\n",
        "        )[:, 1].cpu().numpy()\n",
        "\n",
        "        preds = outputs.argmax(1).cpu().numpy()\n",
        "\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "\n",
        "    prec = precision_score(y_test, preds)\n",
        "\n",
        "    rec = recall_score(y_test, preds)\n",
        "\n",
        "    f1 = f1_score(y_test, preds)\n",
        "\n",
        "    auc = roc_auc_score(y_test, probs)\n",
        "\n",
        "    accs.append(acc)\n",
        "    precs.append(prec)\n",
        "    recs.append(rec)\n",
        "    f1s.append(f1)\n",
        "    aucs.append(auc)\n",
        "\n",
        "    print(f\"Fold {fold}\")\n",
        "\n",
        "    print(f\"Accuracy  : {acc:.4f}\")\n",
        "    print(f\"Precision : {prec:.4f}\")\n",
        "    print(f\"Recall    : {rec:.4f}\")\n",
        "    print(f\"F1-Score  : {f1:.4f}\")\n",
        "    print(f\"AUC       : {auc:.4f}\")\n",
        "\n",
        "    print()\n",
        "\n",
        "    fold += 1\n",
        "\n",
        "# ============================================================\n",
        "# FINAL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" FINAL RESULTS\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "print(f\"Mean Accuracy  : {np.mean(accs)*100:.2f}%\")\n",
        "print(f\"Mean Precision : {np.mean(precs)*100:.2f}%\")\n",
        "print(f\"Mean Recall    : {np.mean(recs)*100:.2f}%\")\n",
        "print(f\"Mean F1-Score  : {np.mean(f1s)*100:.2f}%\")\n",
        "print(f\"Mean AUC       : {np.mean(aucs)*100:.2f}%\")\n",
        "\n",
        "# ============================================================\n",
        "# FINAL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n========== LATENT FEATURE SHAPES ==========\\n\")\n",
        "\n",
        "print(\"Acoustic 32D :\", fused_acoustic_32D.shape)\n",
        "\n",
        "print(\"MEG 32D      :\", fused_meg_32D.shape)\n",
        "\n",
        "print(\"Combined 32D :\", combined_32D.shape)\n",
        "\n",
        "print(\"Labels Shape :\", combined_labels.shape)"
      ],
