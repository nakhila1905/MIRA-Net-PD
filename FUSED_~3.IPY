      "source": [
        "# ============================================================\n",
        "#     SIMPLE + STABLE DANN + SCL + MLP CLASSIFIER\n",
        "#     CROSS-MODAL + CROSS-PARTICIPANT ANALYSIS\n",
        "# ============================================================\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from torch.autograd import Function\n",
        "import torch.nn.functional as F\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score\n",
        ")\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# ============================================================\n",
        "# LOAD DATA\n",
        "# ============================================================\n",
        "\n",
        "# First 7 columns -> Features\n",
        "# Last column     -> PD / HC labels\n",
        "\n",
        "X_acoustic = df_acoustic_top7.iloc[:, :-1].values.astype(np.float32)\n",
        "y_acoustic = df_acoustic_top7.iloc[:, -1].values.astype(np.int64)\n",
        "\n",
        "X_meg = final_meg_df.iloc[:, :-1].values.astype(np.float32)\n",
        "y_meg = final_meg_df.iloc[:, -1].values.astype(np.int64)\n",
        "\n",
        "# ============================================================\n",
        "# STANDARDIZATION\n",
        "# ============================================================\n",
        "\n",
        "scaler_acoustic = StandardScaler()\n",
        "scaler_meg = StandardScaler()\n",
        "\n",
        "X_acoustic = scaler_acoustic.fit_transform(X_acoustic)\n",
        "X_meg = scaler_meg.fit_transform(X_meg)\n",
        "\n",
        "# ============================================================\n",
        "# DOMAIN LABELS\n",
        "# ============================================================\n",
        "\n",
        "# 0 -> Acoustic\n",
        "# 1 -> MEG\n",
        "\n",
        "domain_acoustic = np.zeros(len(X_acoustic))\n",
        "domain_meg = np.ones(len(X_meg))\n",
        "\n",
        "# ============================================================\n",
        "# COMBINE\n",
        "# ============================================================\n",
        "\n",
        "X_all = np.vstack([\n",
        "    X_acoustic,\n",
        "    X_meg\n",
        "]).astype(np.float32)\n",
        "\n",
        "task_labels = np.hstack([\n",
        "    y_acoustic,\n",
        "    y_meg\n",
        "]).astype(np.int64)\n",
        "\n",
        "domain_labels = np.hstack([\n",
        "    domain_acoustic,\n",
        "    domain_meg\n",
        "]).astype(np.int64)\n",
        "\n",
        "# ============================================================\n",
        "# TENSORS\n",
        "# ============================================================\n",
        "\n",
        "X_all_tensor = torch.tensor(\n",
        "    X_all\n",
        ").float().to(device)\n",
        "\n",
        "task_labels_tensor = torch.tensor(\n",
        "    task_labels\n",
        ").long().to(device)\n",
        "\n",
        "domain_labels_tensor = torch.tensor(\n",
        "    domain_labels\n",
        ").long().to(device)\n",
        "\n",
        "# ============================================================\n",
        "# GRADIENT REVERSAL\n",
        "# ============================================================\n",
        "\n",
        "class GradReverse(Function):\n",
        "\n",
        "    @staticmethod\n",
        "    def forward(ctx, x, lambd):\n",
        "\n",
        "        ctx.lambd = lambd\n",
        "\n",
        "        return x.view_as(x)\n",
        "\n",
        "    @staticmethod\n",
        "    def backward(ctx, grad_output):\n",
        "\n",
        "        return -ctx.lambd * grad_output, None\n",
        "\n",
        "def grad_reverse(x, lambd):\n",
        "\n",
        "    return GradReverse.apply(x, lambd)\n",
        "\n",
        "# ============================================================\n",
        "# SIMPLE RESIDUAL BLOCK\n",
        "# ============================================================\n",
        "\n",
        "class ResidualBlock(nn.Module):\n",
        "\n",
        "    def __init__(self, dim):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        self.block = nn.Sequential(\n",
        "\n",
        "            nn.Linear(dim, dim),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(dim, dim)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        return F.relu(\n",
        "            self.block(x) + x\n",
        "        )\n",
        "\n",
        "# ============================================================\n",
        "# DANN + SCL MODEL\n",
        "# ============================================================\n",
        "\n",
        "class DANNContrastive(nn.Module):\n",
        "\n",
        "    def __init__(self, input_dim, latent_dim=32):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        # ====================================================\n",
        "        # SIMPLE ENCODER\n",
        "        # ====================================================\n",
        "\n",
        "        self.encoder = nn.Sequential(\n",
        "\n",
        "            nn.Linear(input_dim, 128),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            ResidualBlock(128),\n",
        "\n",
        "            nn.Linear(128, 64),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Dropout(0.1),\n",
        "\n",
        "            nn.Linear(64, latent_dim)\n",
        "        )\n",
        "\n",
        "        # ====================================================\n",
        "        # TASK HEAD\n",
        "        # ====================================================\n",
        "\n",
        "        self.task_head = nn.Sequential(\n",
        "\n",
        "            nn.Linear(latent_dim, 32),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Dropout(0.2),\n",
        "\n",
        "            nn.Linear(32, 2)\n",
        "        )\n",
        "\n",
        "        # ====================================================\n",
        "        # DOMAIN HEAD\n",
        "        # ====================================================\n",
        "\n",
        "        self.domain_head = nn.Sequential(\n",
        "\n",
        "            nn.Linear(latent_dim, 16),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(16, 2)\n",
        "        )\n",
        "\n",
        "    def forward(self, x, lambd=1.0):\n",
        "\n",
        "        z = self.encoder(x)\n",
        "\n",
        "        # L2 NORMALIZATION\n",
        "\n",
        "        z_norm = F.normalize(\n",
        "            z,\n",
        "            p=2,\n",
        "            dim=1\n",
        "        )\n",
        "\n",
        "        # DANN\n",
        "\n",
        "        rev_z = grad_reverse(\n",
        "            z_norm,\n",
        "            lambd\n",
        "        )\n",
        "\n",
        "        task_out = self.task_head(z_norm)\n",
        "\n",
        "        domain_out = self.domain_head(rev_z)\n",
        "\n",
        "        return task_out, domain_out, z_norm\n",
        "\n",
        "# ============================================================\n",
        "# SUPERVISED CONTRASTIVE LOSS\n",
        "# ============================================================\n",
        "\n",
        "class SupConLoss(nn.Module):\n",
        "\n",
        "    def __init__(self, temperature=0.07):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        self.temperature = temperature\n",
        "\n",
        "    def forward(self, features, labels):\n",
        "\n",
        "        device = features.device\n",
        "\n",
        "        labels = labels.contiguous().view(-1, 1)\n",
        "\n",
        "        mask = torch.eq(\n",
        "            labels,\n",
        "            labels.T\n",
        "        ).float().to(device)\n",
        "\n",
        "        similarity = torch.matmul(\n",
        "            features,\n",
        "            features.T\n",
        "        ) / self.temperature\n",
        "\n",
        "        logits_max, _ = torch.max(\n",
        "            similarity,\n",
        "            dim=1,\n",
        "            keepdim=True\n",
        "        )\n",
        "\n",
        "        logits = similarity - logits_max.detach()\n",
        "\n",
        "        logits_mask = torch.ones_like(mask) - torch.eye(\n",
        "            mask.shape[0]\n",
        "        ).to(device)\n",
        "\n",
        "        mask = mask * logits_mask\n",
        "\n",
        "        exp_logits = torch.exp(logits) * logits_mask\n",
        "\n",
        "        log_prob = logits - torch.log(\n",
        "            exp_logits.sum(1, keepdim=True) + 1e-8\n",
        "        )\n",
        "\n",
        "        mean_log_prob_pos = (\n",
        "            mask * log_prob\n",
        "        ).sum(1) / (mask.sum(1) + 1e-8)\n",
        "\n",
        "        loss = -mean_log_prob_pos.mean()\n",
        "\n",
        "        return loss\n",
        "\n",
        "# ============================================================\n",
        "# DATA LOADER\n",
        "# ============================================================\n",
        "\n",
        "dataset = TensorDataset(\n",
        "    X_all_tensor,\n",
        "    task_labels_tensor,\n",
        "    domain_labels_tensor\n",
        ")\n",
        "\n",
        "loader = DataLoader(\n",
        "    dataset,\n",
        "    batch_size=128,\n",
        "    shuffle=True\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# MODEL\n",
        "# ============================================================\n",
        "\n",
        "model = DANNContrastive(\n",
        "    input_dim=X_all.shape[1],\n",
        "    latent_dim=32\n",
        ").to(device)\n",
        "\n",
        "# ============================================================\n",
        "# OPTIMIZER\n",
        "# ============================================================\n",
        "\n",
        "optimizer = optim.Adam(\n",
        "    model.parameters(),\n",
        "    lr=1e-3,\n",
        "    weight_decay=1e-4\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# LOSSES\n",
        "# ============================================================\n",
        "\n",
        "task_loss_fn = nn.CrossEntropyLoss()\n",
        "\n",
        "domain_loss_fn = nn.CrossEntropyLoss()\n",
        "\n",
        "contrastive_loss_fn = SupConLoss(\n",
        "    temperature=0.07\n",
        ")\n",
        "\n",
        "epochs = 120\n",
        "\n",
        "print(\"\\nTraining Started...\\n\")\n",
        "\n",
        "# ============================================================\n",
        "# TRAINING\n",
        "# ============================================================\n",
        "\n",
        "for epoch in range(epochs):\n",
        "\n",
        "    model.train()\n",
        "\n",
        "    total_correct = 0\n",
        "    total_samples = 0\n",
        "\n",
        "    # ========================================================\n",
        "    # WEAKER DANN\n",
        "    # ========================================================\n",
        "\n",
        "    p = min(epoch / 50.0, 1.0)\n",
        "\n",
        "    lambd = 0.25 * (\n",
        "        2 / (1 + np.exp(-10 * p)) - 1\n",
        "    )\n",
        "\n",
        "    for xb, y_task, y_dom in loader:\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        task_out, dom_out, z = model(\n",
        "            xb,\n",
        "            lambd\n",
        "        )\n",
        "\n",
        "        # ====================================================\n",
        "        # LOSSES\n",
        "        # ====================================================\n",
        "\n",
        "        loss_task = task_loss_fn(\n",
        "            task_out,\n",
        "            y_task\n",
        "        )\n",
        "\n",
        "        loss_domain = domain_loss_fn(\n",
        "            dom_out,\n",
        "            y_dom\n",
        "        )\n",
        "\n",
        "        loss_contrastive = contrastive_loss_fn(\n",
        "            z,\n",
        "            y_task\n",
        "        )\n",
        "\n",
        "        # ====================================================\n",
        "        # FINAL LOSS\n",
        "        # ====================================================\n",
        "\n",
        "        loss = (\n",
        "            3.0 * loss_task +\n",
        "            0.25 * loss_domain +\n",
        "            0.55 * loss_contrastive\n",
        "        )\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer.step()\n",
        "\n",
        "        preds = task_out.argmax(1)\n",
        "\n",
        "        total_correct += (\n",
        "            preds == y_task\n",
        "        ).sum().item()\n",
        "\n",
        "        total_samples += len(y_task)\n",
        "\n",
        "    acc = total_correct / total_samples\n",
        "\n",
        "    print(\n",
        "        f\"Epoch {epoch+1}/{epochs} \"\n",
        "        f\"| λ={lambd:.3f} \"\n",
        "        f\"| Acc={acc:.4f}\"\n",
        "    )\n",
        "\n",
        "# ============================================================\n",
        "# EXTRACT LATENT FEATURES\n",
        "# ============================================================\n",
        "\n",
        "model.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    fused_acoustic_32D = model(\n",
        "        torch.tensor(X_acoustic).float().to(device),\n",
        "        0\n",
        "    )[2].cpu().numpy()\n",
        "\n",
        "    fused_meg_32D = model(\n",
        "        torch.tensor(X_meg).float().to(device),\n",
        "        0\n",
        "    )[2].cpu().numpy()\n",
        "\n",
        "# ============================================================\n",
        "# COMBINE LATENTS\n",
        "# ============================================================\n",
        "\n",
        "X_fused = np.vstack([\n",
        "    fused_acoustic_32D,\n",
        "    fused_meg_32D\n",
        "])\n",
        "\n",
        "y_fused = np.hstack([\n",
        "    y_acoustic,\n",
        "    y_meg\n",
        "])\n",
        "\n",
        "# ============================================================\n",
        "# SIMPLE MLP CLASSIFIER\n",
        "# ============================================================\n",
        "\n",
        "class FinalMLP(nn.Module):\n",
        "\n",
        "    def __init__(self, input_dim=32):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        self.net = nn.Sequential(\n",
        "\n",
        "            nn.Linear(input_dim, 64),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Dropout(0.2),\n",
        "\n",
        "            nn.Linear(64, 32),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(32, 2)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        return self.net(x)\n",
        "\n",
        "# ============================================================\n",
        "# CROSS PARTICIPANT EVALUATION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" CROSS PARTICIPANT ANALYSIS\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "skf = StratifiedKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "accs = []\n",
        "precs = []\n",
        "recs = []\n",
        "f1s = []\n",
        "aucs = []\n",
        "\n",
        "fold = 1\n",
        "\n",
        "for train_idx, test_idx in skf.split(X_fused, y_fused):\n",
        "\n",
        "    X_train = torch.tensor(\n",
        "        X_fused[train_idx]\n",
        "    ).float().to(device)\n",
        "\n",
        "    X_test = torch.tensor(\n",
        "        X_fused[test_idx]\n",
        "    ).float().to(device)\n",
        "\n",
        "    y_train = torch.tensor(\n",
        "        y_fused[train_idx]\n",
        "    ).long().to(device)\n",
        "\n",
        "    y_test = y_fused[test_idx]\n",
        "\n",
        "    clf = FinalMLP().to(device)\n",
        "\n",
        "    optimizer_clf = optim.Adam(\n",
        "        clf.parameters(),\n",
        "        lr=1e-3\n",
        "    )\n",
        "\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    # ========================================================\n",
        "    # TRAIN MLP\n",
        "    # ========================================================\n",
        "\n",
        "    clf.train()\n",
        "\n",
        "    for epoch in range(80):\n",
        "\n",
        "        optimizer_clf.zero_grad()\n",
        "\n",
        "        outputs = clf(X_train)\n",
        "\n",
        "        loss = criterion(\n",
        "            outputs,\n",
        "            y_train\n",
        "        )\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer_clf.step()\n",
        "\n",
        "    # ========================================================\n",
        "    # TEST\n",
        "    # ========================================================\n",
        "\n",
        "    clf.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        outputs = clf(X_test)\n",
        "\n",
        "        probs = F.softmax(\n",
        "            outputs,\n",
        "            dim=1\n",
        "        )[:, 1].cpu().numpy()\n",
        "\n",
        "        preds = outputs.argmax(1).cpu().numpy()\n",
        "\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "\n",
        "    prec = precision_score(y_test, preds)\n",
        "\n",
        "    rec = recall_score(y_test, preds)\n",
        "\n",
        "    f1 = f1_score(y_test, preds)\n",
        "\n",
        "    auc = roc_auc_score(y_test, probs)\n",
        "\n",
        "    accs.append(acc)\n",
        "    precs.append(prec)\n",
        "    recs.append(rec)\n",
        "    f1s.append(f1)\n",
        "    aucs.append(auc)\n",
        "\n",
        "    print(f\"Fold {fold}\")\n",
        "\n",
        "    print(f\"Accuracy  : {acc:.4f}\")\n",
        "    print(f\"Precision : {prec:.4f}\")\n",
        "    print(f\"Recall    : {rec:.4f}\")\n",
        "    print(f\"F1-Score  : {f1:.4f}\")\n",
        "    print(f\"AUC       : {auc:.4f}\")\n",
        "\n",
        "    print()\n",
        "\n",
        "    fold += 1\n",
        "\n",
        "# ============================================================\n",
        "# FINAL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" FINAL RESULTS\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "print(f\"Mean Accuracy  : {np.mean(accs)*100:.2f}%\")\n",
        "print(f\"Mean Precision : {np.mean(precs)*100:.2f}%\")\n",
        "print(f\"Mean Recall    : {np.mean(recs)*100:.2f}%\")\n",
        "print(f\"Mean F1-Score  : {np.mean(f1s)*100:.2f}%\")\n",
        "print(f\"Mean AUC       : {np.mean(aucs)*100:.2f}%\")\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" LATENT SHAPES\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "print(\"Acoustic :\", fused_acoustic_32D.shape)\n",
        "print(\"MEG      :\", fused_meg_32D.shape)"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "Concatenating acoustic and meg"
      ],
