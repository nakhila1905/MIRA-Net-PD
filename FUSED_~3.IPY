        "\n",
        "final_meg_df = pd.read_csv('/content/drive/MyDrive/final_meg-passive(par)_top7_rfc+shap_10-fold_analysis_last_column.csv')\n",
        "\n",
        "print(\"Loaded data shape:\", final_meg_df.shape)\n",
        "print(final_meg_df.head())\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "H-VwOV2JEZXF",
        "outputId": "6a2bb343-ef0d-4b3d-ebb7-6977750e1364"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Loaded data shape: (127, 8)\n",
            "   env_kurt_asym  burst_amp_cv_asym  env_kurt_R_mean  env_mod_rate_L_std  \\\n",
            "0      -0.076816           0.013925         2.510726            0.296017   \n",
            "1      -0.053170          -0.011675         2.189911            0.076190   \n",
            "2       0.073234           0.010955         1.217854            0.413152   \n",
            "3       0.077393           0.027533         1.394646            0.467633   \n",
            "4       0.022059           0.005688         1.268945            0.309523   \n",
            "\n",
            "   env_mod_rate_R_std  mean_burst_duration_R_std  env_mod_rate_R_mean  \\\n",
            "0            0.312178                   0.002180             0.421821   \n",
            "1            0.063898                   0.012065             0.208876   \n",
            "2            0.278854                   0.001874             0.462511   \n",
            "3            0.511813                   0.003089             0.637478   \n",
            "4            0.341810                   0.004726             0.295681   \n",
            "\n",
            "   PD_Label_Combined  \n",
            "0                  0  \n",
            "1                  0  \n",
            "2                  0  \n",
            "3                  1  \n",
            "4                  1  \n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "#                VANILLA DANN BASELINE\n",
        "#     DOMAIN + TASK ADVERSARIAL LEARNING\n",
        "#          + 5-FOLD CROSS VALIDATION\n",
        "# ============================================================\n",
        "\n",
        "# ============================================================\n",
        "# IMPORTS\n",
        "# ============================================================\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from torch.autograd import Function\n",
        "\n",
        "import torch.nn.functional as F\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score\n",
        ")\n",
        "\n",
        "device = torch.device(\n",
        "    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# LOAD DATA\n",
        "# ============================================================\n",
        "\n",
        "X_acoustic = df_acoustic_top7.iloc[:, :-1].values.astype(np.float32)\n",
        "y_acoustic = df_acoustic_top7.iloc[:, -1].values.astype(np.int32)\n",
        "\n",
        "X_meg = final_meg_df.iloc[:, :-1].values.astype(np.float32)\n",
        "y_meg = final_meg_df.iloc[:, -1].values.astype(np.int32)\n",
        "\n",
        "# ============================================================\n",
        "# STANDARDIZATION\n",
        "# ============================================================\n",
        "\n",
        "scaler_acoustic = StandardScaler()\n",
        "scaler_meg = StandardScaler()\n",
        "\n",
        "X_acoustic = scaler_acoustic.fit_transform(X_acoustic)\n",
        "X_meg = scaler_meg.fit_transform(X_meg)\n",
        "\n",
        "# ============================================================\n",
        "# DOMAIN LABELS\n",
        "# ============================================================\n",
        "\n",
        "domain_acoustic = np.zeros(len(X_acoustic))\n",
        "domain_meg = np.ones(len(X_meg))\n",
        "\n",
        "# ============================================================\n",
        "# COMBINE DATA\n",
        "# ============================================================\n",
        "\n",
        "X_all = np.vstack([\n",
        "    X_acoustic,\n",
        "    X_meg\n",
        "]).astype(np.float32)\n",
        "\n",
        "task_labels = np.hstack([\n",
        "    y_acoustic,\n",
        "    y_meg\n",
        "]).astype(np.int32)\n",
        "\n",
        "domain_labels = np.hstack([\n",
        "    domain_acoustic,\n",
        "    domain_meg\n",
        "]).astype(np.int32)\n",
        "\n",
        "# ============================================================\n",
        "# TENSORS\n",
        "# ============================================================\n",
        "\n",
        "X_all_tensor = torch.tensor(\n",
        "    X_all\n",
        ").float().to(device)\n",
        "\n",
        "task_labels_tensor = torch.tensor(\n",
        "    task_labels\n",
        ").long().to(device)\n",
        "\n",
        "domain_labels_tensor = torch.tensor(\n",
        "    domain_labels\n",
        ").long().to(device)\n",
        "\n",
        "# ============================================================\n",
        "# DATA LOADER\n",
        "# ============================================================\n",
        "\n",
        "dataset = TensorDataset(\n",
        "    X_all_tensor,\n",
        "    task_labels_tensor,\n",
        "    domain_labels_tensor\n",
        ")\n",
        "\n",
        "loader = DataLoader(\n",
        "    dataset,\n",
        "    batch_size=128,\n",
        "    shuffle=True\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# GRADIENT REVERSAL LAYER\n",
        "# ============================================================\n",
        "\n",
        "class GradReverse(Function):\n",
        "\n",
        "    @staticmethod\n",
        "    def forward(ctx, x, lambd=1.0):\n",
        "\n",
        "        ctx.lambd = lambd\n",
        "\n",
        "        return x.view_as(x)\n",
        "\n",
        "    @staticmethod\n",
        "    def backward(ctx, grad_output):\n",
        "\n",
        "        return -ctx.lambd * grad_output, None\n",
        "\n",
        "def grad_reverse(x, lambd=1.0):\n",
        "\n",
        "    return GradReverse.apply(x, lambd)\n",
        "\n",
        "# ============================================================\n",
        "# VANILLA DANN MODEL\n",
        "# ============================================================\n",
        "\n",
        "class VanillaDANN(nn.Module):\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        input_dim=7,\n",
        "        hidden_dim=32,\n",
        "        task_classes=2,\n",
        "        domain_classes=2\n",
        "    ):\n",
        "\n",
        "        super(VanillaDANN, self).__init__()\n",
        "\n",
        "        self.feature_extractor = nn.Sequential(\n",
        "\n",
        "            nn.Linear(input_dim, 32),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(32, hidden_dim),\n",
        "            nn.ReLU()\n",
        "        )\n",
        "\n",
        "        self.task_classifier = nn.Sequential(\n",
        "\n",
        "            nn.Linear(hidden_dim, 32),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(32, task_classes)\n",
        "        )\n",
        "\n",
        "        self.domain_classifier = nn.Sequential(\n",
        "\n",
        "            nn.Linear(hidden_dim, 32),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(32, domain_classes)\n",
        "        )\n",
        "\n",
        "    def forward(self, x, lambd=1.0):\n",
        "\n",
        "        features = self.feature_extractor(x)\n",
        "\n",
        "        task_out = self.task_classifier(features)\n",
        "\n",
        "        reversed_feat = grad_reverse(\n",
        "            features,\n",
        "            lambd\n",
        "        )\n",
        "\n",
        "        domain_out = self.domain_classifier(\n",
        "            reversed_feat\n",
        "        )\n",
        "\n",
        "        return task_out, domain_out, features\n",
        "\n",
        "# ============================================================\n",
        "# MODEL\n",
        "# ============================================================\n",
        "\n",
        "model = VanillaDANN().to(device)\n",
        "\n",
        "# ============================================================\n",
        "# OPTIMIZER\n",
        "# ============================================================\n",
        "\n",
        "optimizer = optim.Adam(\n",
        "    model.parameters(),\n",
        "    lr=0.001\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# LOSSES\n",
        "# ============================================================\n",
        "\n",
        "task_loss_fn = nn.CrossEntropyLoss()\n",
        "\n",
        "domain_loss_fn = nn.CrossEntropyLoss()\n",
        "\n",
        "# ============================================================\n",
        "# TRAINING\n",
        "# ============================================================\n",
        "\n",
        "epochs = 120\n",
        "\n",
        "print(\"\\nTraining Vanilla DANN...\\n\")\n",
        "\n",
        "for epoch in range(epochs):\n",
        "\n",
        "    model.train()\n",
        "\n",
        "    total_loss = 0\n",
        "    total_correct = 0\n",
        "    total_samples = 0\n",
        "\n",
        "    p = min(epoch / 50.0, 1.0)\n",
        "\n",
        "    lambd = 2 / (1 + np.exp(-10 * p)) - 1\n",
        "\n",
        "    for x_batch, y_batch, d_batch in loader:\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        task_out, domain_out, _ = model(\n",
        "            x_batch,\n",
        "            lambd\n",
        "        )\n",
        "\n",
        "        loss_task = task_loss_fn(\n",
        "            task_out,\n",
        "            y_batch\n",
        "        )\n",
        "\n",
        "        loss_domain = domain_loss_fn(\n",
        "            domain_out,\n",
        "            d_batch\n",
        "        )\n",
        "\n",
        "        loss = (\n",
        "            loss_task +\n",
        "            0.5 * loss_domain\n",
        "        )\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer.step()\n",
        "\n",
        "        total_loss += loss.item()\n",
        "\n",
        "        preds = task_out.argmax(1)\n",
        "\n",
        "        total_correct += (\n",
        "            preds == y_batch\n",
        "        ).sum().item()\n",
        "\n",
        "        total_samples += len(y_batch)\n",
        "\n",
        "    acc = total_correct / total_samples\n",
        "\n",
        "    print(\n",
        "        f\"Epoch {epoch+1}/{epochs} \"\n",
        "        f\"| λ={lambd:.3f} \"\n",
        "        f\"| Loss={total_loss:.4f} \"\n",
        "        f\"| Task Acc={acc:.4f}\"\n",
        "    )\n",
        "\n",
        "# ============================================================\n",
        "# EXTRACT LATENT FEATURES\n",
        "# ============================================================\n",
        "\n",
        "model.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    _, _, acoustic_latent = model(\n",
        "        torch.tensor(X_acoustic).float().to(device),\n",
        "        0\n",
        "    )\n",
        "\n",
        "    _, _, meg_latent = model(\n",
        "        torch.tensor(X_meg).float().to(device),\n",
        "        0\n",
        "    )\n",
        "\n",
        "# ============================================================\n",
        "# CONVERT TO NUMPY\n",
        "# ============================================================\n",
        "\n",
        "fused_acoustic_32D = acoustic_latent.cpu().numpy()\n",
        "\n",
        "fused_meg_32D = meg_latent.cpu().numpy()\n",
        "\n",
        "# ============================================================\n",
        "# COMBINE LATENT FEATURES\n",
        "# ============================================================\n",
        "\n",
        "X_fused = np.vstack([\n",
        "    fused_acoustic_32D,\n",
        "    fused_meg_32D\n",
        "])\n",
        "\n",
        "y_fused = np.hstack([\n",
        "    y_acoustic,\n",
        "    y_meg\n",
        "])\n",
        "\n",
        "# ============================================================\n",
        "# FINAL MLP CLASSIFIER\n",
        "# ============================================================\n",
        "\n",
        "class FinalMLP(nn.Module):\n",
        "\n",
        "    def __init__(self, input_dim=32):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        self.net = nn.Sequential(\n",
        "\n",
        "            nn.Linear(input_dim, 64),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Dropout(0.2),\n",
        "\n",
        "            nn.Linear(64, 32),\n",
        "            nn.ReLU(),\n",
        "\n",
        "            nn.Linear(32, 2)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        return self.net(x)\n",
        "\n",
        "# ============================================================\n",
        "# 5-FOLD CROSS VALIDATION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" CROSS VALIDATION RESULTS\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "skf = StratifiedKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "accs = []\n",
        "precs = []\n",
        "recs = []\n",
        "f1s = []\n",
        "aucs = []\n",
        "\n",
        "fold = 1\n",
        "\n",
        "for train_idx, test_idx in skf.split(X_fused, y_fused):\n",
        "\n",
        "    X_train = torch.tensor(\n",
        "        X_fused[train_idx]\n",
        "    ).float().to(device)\n",
        "\n",
        "    X_test = torch.tensor(\n",
        "        X_fused[test_idx]\n",
        "    ).float().to(device)\n",
        "\n",
        "    y_train = torch.tensor(\n",
        "        y_fused[train_idx]\n",
        "    ).long().to(device)\n",
        "\n",
        "    y_test = y_fused[test_idx]\n",
        "\n",
        "    clf = FinalMLP().to(device)\n",
        "\n",
        "    optimizer_clf = optim.Adam(\n",
        "        clf.parameters(),\n",
        "        lr=1e-3\n",
        "    )\n",
        "\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    # ========================================================\n",
        "    # TRAIN CLASSIFIER\n",
        "    # ========================================================\n",
        "\n",
        "    clf.train()\n",
        "\n",
        "    for epoch in range(80):\n",
        "\n",
        "        optimizer_clf.zero_grad()\n",
        "\n",
        "        outputs = clf(X_train)\n",
        "\n",
        "        loss = criterion(\n",
        "            outputs,\n",
        "            y_train\n",
        "        )\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer_clf.step()\n",
        "\n",
        "    # ========================================================\n",
        "    # TEST\n",
        "    # ========================================================\n",
        "\n",
        "    clf.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        outputs = clf(X_test)\n",
        "\n",
        "        probs = F.softmax(\n",
        "            outputs,\n",
        "            dim=1\n",
        "        )[:, 1].cpu().numpy()\n",
        "\n",
        "        preds = outputs.argmax(1).cpu().numpy()\n",
        "\n",
        "    acc = accuracy_score(y_test, preds)\n",
        "\n",
        "    prec = precision_score(y_test, preds)\n",
        "\n",
        "    rec = recall_score(y_test, preds)\n",
        "\n",
        "    f1 = f1_score(y_test, preds)\n",
        "\n",
        "    auc = roc_auc_score(y_test, probs)\n",
        "\n",
        "    accs.append(acc)\n",
        "    precs.append(prec)\n",
        "    recs.append(rec)\n",
        "    f1s.append(f1)\n",
        "    aucs.append(auc)\n",
        "\n",
        "    print(f\"Fold {fold}\")\n",
        "\n",
        "    print(f\"Accuracy  : {acc:.4f}\")\n",
        "    print(f\"Precision : {prec:.4f}\")\n",
        "    print(f\"Recall    : {rec:.4f}\")\n",
        "    print(f\"F1-Score  : {f1:.4f}\")\n",
        "    print(f\"AUC       : {auc:.4f}\")\n",
        "\n",
        "    print()\n",
        "\n",
        "    fold += 1\n",
        "\n",
        "# ============================================================\n",
        "# FINAL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" FINAL RESULTS\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "print(f\"Mean Accuracy  : {np.mean(accs)*100:.2f}%\")\n",
        "print(f\"Mean Precision : {np.mean(precs)*100:.2f}%\")\n",
        "print(f\"Mean Recall    : {np.mean(recs)*100:.2f}%\")\n",
        "print(f\"Mean F1-Score  : {np.mean(f1s)*100:.2f}%\")\n",
        "print(f\"Mean AUC       : {np.mean(aucs)*100:.2f}%\")\n",
        "\n",
        "# ============================================================\n",
        "# LATENT SHAPES\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n===================================\")\n",
        "print(\" LATENT FEATURE SHAPES\")\n",
        "print(\"===================================\\n\")\n",
        "\n",
        "print(\n",
        "    f\"Acoustic Latent Shape: \"\n",
        "    f\"{fused_acoustic_32D.shape}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"MEG Latent Shape: \"\n",
        "    f\"{fused_meg_32D.shape}\"\n",
        ")"
      ],
