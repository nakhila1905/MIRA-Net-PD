    {
      "cell_type": "markdown",
      "source": [
        "Evaluation"
      ],
      "metadata": {
        "id": "tfhdiLrwGqX1"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# ###8)###\n",
        "# ENSEMBLE CLASSIFICATION WITH STRATIFIED 10-FOLD CV\n",
        "# ============================================================\n",
        "\n",
        "# ------------------ Install Required Packages ------------------\n",
        "\n",
        "!pip install xgboost lightgbm catboost scikit-learn statsmodels matplotlib seaborn --quiet\n",
        "\n",
        "\n",
        "# ------------------ Imports ------------------\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from sklearn.utils.class_weight import compute_class_weight\n",
        "\n",
        "from sklearn.model_selection import (\n",
        "    train_test_split,\n",
        "    StratifiedKFold\n",
        ")\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score,\n",
        "    balanced_accuracy_score,\n",
        "    matthews_corrcoef,\n",
        "    confusion_matrix\n",
        ")\n",
        "\n",
        "from sklearn.ensemble import (\n",
        "    VotingClassifier,\n",
        "    StackingClassifier,\n",
        "    RandomForestClassifier,\n",
        "    HistGradientBoostingClassifier\n",
        ")\n",
        "\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "\n",
        "from xgboost import XGBClassifier\n",
        "\n",
        "from statsmodels.stats.proportion import proportion_confint\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 1: PREPARE DATA\n",
        "# ============================================================\n",
        "\n",
        "X = fused_df_named_int[\n",
        "    [f'feat_{i}' for i in range(32)]\n",
        "].copy()\n",
        "\n",
        "y = fused_df_named_int[\n",
        "    \"PD_Label_Combined\"\n",
        "].copy()\n",
        "\n",
        "\n",
        "# ------------------ Convert X to numeric ------------------\n",
        "\n",
        "X = X.apply(\n",
        "    pd.to_numeric,\n",
        "    errors='coerce'\n",
        ")\n",
        "\n",
        "X.fillna(\n",
        "    0,\n",
        "    inplace=True\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 2: CLASS WEIGHTS\n",
        "# ============================================================\n",
        "\n",
        "classes = np.unique(y)\n",
        "\n",
        "class_weights = compute_class_weight(\n",
        "    class_weight='balanced',\n",
        "    classes=classes,\n",
        "    y=y\n",
        ")\n",
        "\n",
        "class_weights_dict = {\n",
        "    int(classes[0]): float(class_weights[0]),\n",
        "    int(classes[1]): float(class_weights[1])\n",
        "}\n",
        "\n",
        "print(\"\\nClass Weights:\")\n",
        "print(class_weights_dict)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 3: TRAIN-TEST SPLIT\n",
        "# ============================================================\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X,\n",
        "    y,\n",
        "    test_size=0.2,\n",
        "    stratify=y,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nTrain Shape :\", X_train.shape)\n",
        "print(\"Test Shape  :\", X_test.shape)\n",
        "\n",
        "print(\"\\nTraining Class Distribution:\")\n",
        "print(y_train.value_counts())\n",
        "\n",
        "print(\"\\nTesting Class Distribution:\")\n",
        "print(y_test.value_counts())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 4: HANDLE CLASS IMBALANCE\n",
        "# ============================================================\n",
        "\n",
        "cw = compute_class_weight(\n",
        "    class_weight='balanced',\n",
        "    classes=np.unique(y_train),\n",
        "    y=y_train\n",
        ")\n",
        "\n",
        "cw_dict = dict(\n",
        "    zip(\n",
        "        np.unique(y_train),\n",
        "        cw\n",
        "    )\n",
        ")\n",
        "\n",
        "scale_pos_weight = (\n",
        "    cw[1] / cw[0]\n",
        ")\n",
        "\n",
        "print(\"\\nTraining Class Weights:\")\n",
        "print(cw_dict)\n",
        "\n",
        "print(\n",
        "    \"\\nXGBoost scale_pos_weight:\",\n",
        "    scale_pos_weight\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 5: BASE MODEL CREATION FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def create_models():\n",
        "\n",
        "    # ---------------- XGBoost ----------------\n",
        "\n",
        "    xgb = XGBClassifier(\n",
        "        n_estimators=200,\n",
        "        max_depth=4,\n",
        "        learning_rate=0.05,\n",
        "        subsample=0.8,\n",
        "        colsample_bytree=0.8,\n",
        "\n",
        "        scale_pos_weight=scale_pos_weight,\n",
        "\n",
        "        eval_metric='logloss',\n",
        "\n",
        "        random_state=42,\n",
        "        n_jobs=-1\n",
        "    )\n",
        "\n",
        "\n",
        "    # ---------------- Random Forest ----------------\n",
        "\n",
        "    rf = RandomForestClassifier(\n",
        "        n_estimators=200,\n",
        "\n",
        "        class_weight='balanced',\n",
        "\n",
        "        random_state=42,\n",
        "        n_jobs=-1\n",
        "    )\n",
        "\n",
        "\n",
        "    # ---------------- HistGradientBoosting ----------------\n",
        "\n",
        "    hgb = HistGradientBoostingClassifier(\n",
        "        max_iter=200,\n",
        "        learning_rate=0.05,\n",
        "        max_leaf_nodes=31,\n",
        "\n",
        "        class_weight='balanced',\n",
        "\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "\n",
        "    return xgb, rf, hgb\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 6: STRATIFIED 10-FOLD CV\n",
        "# ============================================================\n",
        "\n",
        "skf = StratifiedKFold(\n",
        "    n_splits=10,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 7: EVALUATION FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def evaluate_model(model_name):\n",
        "\n",
        "    # ========================================================\n",
        "    # CV METRIC STORAGE\n",
        "    # ========================================================\n",
        "\n",
        "    cv_accuracy = []\n",
        "    cv_precision = []\n",
        "    cv_sensitivity = []\n",
        "    cv_f1 = []\n",
        "    cv_auc = []\n",
        "    cv_balanced_accuracy = []\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 10-FOLD STRATIFIED CROSS-VALIDATION\n",
        "    # ========================================================\n",
        "\n",
        "    for fold, (train_idx, val_idx) in enumerate(\n",
        "        skf.split(X_train, y_train),\n",
        "        start=1\n",
        "    ):\n",
        "\n",
        "        print(\n",
        "            f\"\\n{model_name} | Fold {fold}/10\"\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Split fold\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        X_tr = X_train.iloc[\n",
        "            train_idx\n",
        "        ]\n",
        "\n",
        "        X_val = X_train.iloc[\n",
        "            val_idx\n",
        "        ]\n",
        "\n",
        "        y_tr = y_train.iloc[\n",
        "            train_idx\n",
        "        ]\n",
        "\n",
        "        y_val = y_train.iloc[\n",
        "            val_idx\n",
        "        ]\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Scaling INSIDE EACH FOLD\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        scaler = StandardScaler()\n",
        "\n",
        "        X_tr_scaled = scaler.fit_transform(\n",
        "            X_tr\n",
        "        )\n",
        "\n",
        "        X_val_scaled = scaler.transform(\n",
        "            X_val\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Create FRESH models for every fold\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        xgb, rf, hgb = create_models()\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Select requested model\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        if model_name == \"XGBoost\":\n",
        "\n",
        "            model = xgb\n",
        "\n",
        "\n",
        "        elif model_name == \"Random Forest\":\n",
        "\n",
        "            model = rf\n",
        "\n",
        "\n",
        "        elif model_name == \"HistGradientBoosting\":\n",
        "\n",
        "            model = hgb\n",
        "\n",
        "\n",
        "        elif model_name == \"Voting Fusion\":\n",
        "\n",
        "            model = VotingClassifier(\n",
        "                estimators=[\n",
        "                    ('xgb', xgb),\n",
        "                    ('rf', rf),\n",
        "                    ('hgb', hgb)\n",
        "                ],\n",
        "                voting='soft'\n",
        "            )\n",
        "\n",
        "\n",
        "        elif model_name == \"Stacking Fusion\":\n",
        "\n",
        "            model = StackingClassifier(\n",
        "                estimators=[\n",
        "                    ('xgb', xgb),\n",
        "                    ('rf', rf),\n",
        "                    ('hgb', hgb)\n",
        "                ],\n",
        "\n",
        "                final_estimator=LogisticRegression(\n",
        "                    max_iter=1000,\n",
        "                    class_weight='balanced'\n",
        "                ),\n",
        "\n",
        "                passthrough=True,\n",
        "\n",
        "                cv=5\n",
        "            )\n",
        "\n",
        "\n",
        "        else:\n",
        "\n",
        "            raise ValueError(\n",
        "                f\"Unknown model: {model_name}\"\n",
        "            )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Train fold\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        model.fit(\n",
        "            X_tr_scaled,\n",
        "            y_tr\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Validation predictions\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        val_preds = model.predict(\n",
        "            X_val_scaled\n",
        "        )\n",
        "\n",
        "        val_probs = model.predict_proba(\n",
        "            X_val_scaled\n",
        "        )[:, 1]\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Fold metrics\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        fold_accuracy = accuracy_score(\n",
        "            y_val,\n",
        "            val_preds\n",
        "        )\n",
        "\n",
        "        fold_precision = precision_score(\n",
        "            y_val,\n",
        "            val_preds,\n",
        "            zero_division=0\n",
        "        )\n",
        "\n",
        "        fold_sensitivity = recall_score(\n",
        "            y_val,\n",
        "            val_preds,\n",
        "            zero_division=0\n",
        "        )\n",
        "\n",
        "        fold_f1 = f1_score(\n",
        "            y_val,\n",
        "            val_preds,\n",
        "            zero_division=0\n",
        "        )\n",
        "\n",
        "        fold_auc = roc_auc_score(\n",
        "            y_val,\n",
        "            val_probs\n",
        "        )\n",
        "\n",
        "        fold_balanced_accuracy = balanced_accuracy_score(\n",
        "            y_val,\n",
        "            val_preds\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Store fold metrics\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        cv_accuracy.append(\n",
        "            fold_accuracy\n",
        "        )\n",
        "\n",
        "        cv_precision.append(\n",
        "            fold_precision\n",
        "        )\n",
        "\n",
        "        cv_sensitivity.append(\n",
        "            fold_sensitivity\n",
        "        )\n",
        "\n",
        "        cv_f1.append(\n",
        "            fold_f1\n",
        "        )\n",
        "\n",
        "        cv_auc.append(\n",
        "            fold_auc\n",
        "        )\n",
        "\n",
        "        cv_balanced_accuracy.append(\n",
        "            fold_balanced_accuracy\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Print fold result\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        print(\n",
        "            f\"Accuracy            : {fold_accuracy:.4f}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Precision           : {fold_precision:.4f}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Sensitivity         : {fold_sensitivity:.4f}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"F1 Score            : {fold_f1:.4f}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"ROC-AUC             : {fold_auc:.4f}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Balanced Accuracy   : \"\n",
        "            f\"{fold_balanced_accuracy:.4f}\"\n",
        "        )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # CV MEAN RESULTS\n",
        "    # ========================================================\n",
        "\n",
        "    cv_accuracy_mean = np.mean(\n",
        "        cv_accuracy\n",
        "    )\n",
        "\n",
        "    cv_precision_mean = np.mean(\n",
        "        cv_precision\n",
        "    )\n",
        "\n",
        "    cv_sensitivity_mean = np.mean(\n",
        "        cv_sensitivity\n",
        "    )\n",
        "\n",
        "    cv_f1_mean = np.mean(\n",
        "        cv_f1\n",
        "    )\n",
        "\n",
        "    cv_auc_mean = np.mean(\n",
        "        cv_auc\n",
        "    )\n",
        "\n",
        "    cv_balanced_accuracy_mean = np.mean(\n",
        "        cv_balanced_accuracy\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # CROSS-VALIDATION RESULTS\n",
        "    # ========================================================\n",
        "\n",
        "    print(\n",
        "        \"\\n================================================\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"{model_name} - Cross-Validation (10-fold)\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"================================================\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Accuracy            : \"\n",
        "        f\"{cv_accuracy_mean:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Precision           : \"\n",
        "        f\"{cv_precision_mean:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Recall/Sensitivity  : \"\n",
        "        f\"{cv_sensitivity_mean:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"F1 Score            : \"\n",
        "        f\"{cv_f1_mean:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"ROC-AUC             : \"\n",
        "        f\"{cv_auc_mean:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Balanced Accuracy   : \"\n",
        "        f\"{cv_balanced_accuracy_mean:.4f}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # TRAIN FINAL MODEL ON COMPLETE TRAINING SET\n",
        "    # ========================================================\n",
        "\n",
        "    final_scaler = StandardScaler()\n",
        "\n",
        "    X_train_final_scaled = final_scaler.fit_transform(\n",
        "        X_train\n",
        "    )\n",
        "\n",
        "    X_test_final_scaled = final_scaler.transform(\n",
        "        X_test\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Create fresh final models\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    xgb, rf, hgb = create_models()\n",
        "\n",
        "\n",
        "    if model_name == \"XGBoost\":\n",
        "\n",
        "        final_model = xgb\n",
        "\n",
        "\n",
        "    elif model_name == \"Random Forest\":\n",
        "\n",
        "        final_model = rf\n",
        "\n",
        "\n",
        "    elif model_name == \"HistGradientBoosting\":\n",
        "\n",
        "        final_model = hgb\n",
        "\n",
        "\n",
        "    elif model_name == \"Voting Fusion\":\n",
        "\n",
        "        final_model = VotingClassifier(\n",
        "            estimators=[\n",
        "                ('xgb', xgb),\n",
        "                ('rf', rf),\n",
        "                ('hgb', hgb)\n",
        "            ],\n",
        "            voting='soft'\n",
        "        )\n",
        "\n",
        "\n",
        "    elif model_name == \"Stacking Fusion\":\n",
        "\n",
        "        final_model = StackingClassifier(\n",
        "            estimators=[\n",
        "                ('xgb', xgb),\n",
        "                ('rf', rf),\n",
        "                ('hgb', hgb)\n",
        "            ],\n",
        "\n",
        "            final_estimator=LogisticRegression(\n",
        "                max_iter=1000,\n",
        "                class_weight='balanced'\n",
        "            ),\n",
        "\n",
        "            passthrough=True,\n",
        "\n",
        "            cv=5\n",
        "        )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # FINAL TRAINING\n",
        "    # ========================================================\n",
        "\n",
        "    final_model.fit(\n",
        "        X_train_final_scaled,\n",
        "        y_train\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # TEST PREDICTIONS\n",
        "    # ========================================================\n",
        "\n",
        "    test_preds = final_model.predict(\n",
        "        X_test_final_scaled\n",
        "    )\n",
        "\n",
        "    test_probs = final_model.predict_proba(\n",
        "        X_test_final_scaled\n",
        "    )[:, 1]\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # TEST METRICS\n",
        "    # ========================================================\n",
        "\n",
        "    accuracy = accuracy_score(\n",
        "        y_test,\n",
        "        test_preds\n",
        "    )\n",
        "\n",
        "    precision = precision_score(\n",
        "        y_test,\n",
        "        test_preds,\n",
        "        zero_division=0\n",
        "    )\n",
        "\n",
        "    sensitivity = recall_score(\n",
        "        y_test,\n",
        "        test_preds,\n",
        "        zero_division=0\n",
        "    )\n",
        "\n",
        "    f1 = f1_score(\n",
        "        y_test,\n",
        "        test_preds,\n",
        "        zero_division=0\n",
        "    )\n",
        "\n",
        "    roc_auc = roc_auc_score(\n",
        "        y_test,\n",
        "        test_probs\n",
        "    )\n",
        "\n",
        "    balanced_accuracy = balanced_accuracy_score(\n",
        "        y_test,\n",
        "        test_preds\n",
        "    )\n",
        "\n",
        "    mcc = matthews_corrcoef(\n",
        "        y_test,\n",
        "        test_preds\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # CONFUSION MATRIX\n",
        "    # ========================================================\n",
        "\n",
        "    cm = confusion_matrix(\n",
        "        y_test,\n",
        "        test_preds,\n",
        "        labels=[0, 1]\n",
        "    )\n",
        "\n",
        "    tn, fp, fn, tp = cm.ravel()\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # SENSITIVITY / SPECIFICITY\n",
        "    # ========================================================\n",
        "\n",
        "    sensitivity = (\n",
        "        tp / (tp + fn)\n",
        "        if (tp + fn) > 0\n",
        "        else 0\n",
        "    )\n",
        "\n",
        "    specificity = (\n",
        "        tn / (tn + fp)\n",
        "        if (tn + fp) > 0\n",
        "        else 0\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 95% CONFIDENCE INTERVALS\n",
        "    # ========================================================\n",
        "\n",
        "    # ---------------- Accuracy CI ----------------\n",
        "\n",
        "    acc_low, acc_high = proportion_confint(\n",
        "        count=int(round(accuracy * len(y_test))),\n",
        "        nobs=len(y_test),\n",
        "        alpha=0.05,\n",
        "        method='wilson'\n",
        "    )\n",
        "\n",
        "\n",
        "    # ---------------- Precision CI ----------------\n",
        "\n",
        "    precision_low, precision_high = proportion_confint(\n",
        "        count=tp,\n",
        "        nobs=(tp + fp),\n",
        "        alpha=0.05,\n",
        "        method='wilson'\n",
        "    ) if (tp + fp) > 0 else (0.0, 0.0)\n",
        "\n",
        "\n",
        "    # ---------------- Sensitivity CI ----------------\n",
        "\n",
        "    sensitivity_low, sensitivity_high = proportion_confint(\n",
        "        count=tp,\n",
        "        nobs=(tp + fn),\n",
        "        alpha=0.05,\n",
        "        method='wilson'\n",
        "    ) if (tp + fn) > 0 else (0.0, 0.0)\n",
        "\n",
        "\n",
        "    # ---------------- Specificity CI ----------------\n",
        "\n",
        "    specificity_low, specificity_high = proportion_confint(\n",
        "        count=tn,\n",
        "        nobs=(tn + fp),\n",
        "        alpha=0.05,\n",
        "        method='wilson'\n",
        "    ) if (tn + fp) > 0 else (0.0, 0.0)\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # TEST SET PERFORMANCE\n",
        "    # ========================================================\n",
        "\n",
        "    print(\n",
        "        \"\\n================================================\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"{model_name} - Test Set Performance\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"================================================\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Accuracy            : {accuracy:.4f} \"\n",
        "        f\"(95% CI: \"\n",
        "        f\"{acc_low:.4f}-{acc_high:.4f})\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Precision           : {precision:.4f} \"\n",
        "        f\"(95% CI: \"\n",
        "        f\"{precision_low:.4f}-{precision_high:.4f})\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Sensitivity         : {sensitivity:.4f} \"\n",
        "        f\"(95% CI: \"\n",
        "        f\"{sensitivity_low:.4f}-{sensitivity_high:.4f})\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Specificity         : {specificity:.4f} \"\n",
        "        f\"(95% CI: \"\n",
        "        f\"{specificity_low:.4f}-{specificity_high:.4f})\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"F1 Score            : {f1:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"ROC-AUC             : {roc_auc:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Balanced Accuracy   : \"\n",
        "        f\"{balanced_accuracy:.4f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"MCC                 : {mcc:.4f}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # CONFUSION MATRIX\n",
        "    # ========================================================\n",
        "\n",
        "    print(\n",
        "        \"\\nConfusion Matrix:\"\n",
        "    )\n",
        "\n",
        "    print(cm)\n",
        "\n",
        "    print(\n",
        "        \"\\nTN :\", tn\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"FP :\", fp\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"FN :\", fn\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"TP :\", tp\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # STORE RESULTS\n",
        "    # ========================================================\n",
        "\n",
        "    result = {\n",
        "\n",
        "        # ---------------- CV ----------------\n",
        "\n",
        "        \"CV Accuracy\":\n",
        "            cv_accuracy_mean,\n",
        "\n",
        "        \"CV Precision\":\n",
        "            cv_precision_mean,\n",
        "\n",
        "        \"CV Sensitivity\":\n",
        "            cv_sensitivity_mean,\n",
        "\n",
        "        \"CV F1\":\n",
        "            cv_f1_mean,\n",
        "\n",
        "        \"CV ROC-AUC\":\n",
        "            cv_auc_mean,\n",
        "\n",
        "        \"CV Balanced Accuracy\":\n",
        "            cv_balanced_accuracy_mean,\n",
        "\n",
        "\n",
        "        # ---------------- Test ----------------\n",
        "\n",
        "        \"Accuracy\":\n",
        "            accuracy,\n",
        "\n",
        "        \"Accuracy CI Low\":\n",
        "            acc_low,\n",
        "\n",
        "        \"Accuracy CI High\":\n",
        "            acc_high,\n",
        "\n",
        "\n",
        "        \"Precision\":\n",
        "            precision,\n",
        "\n",
        "        \"Precision CI Low\":\n",
        "            precision_low,\n",
        "\n",
        "        \"Precision CI High\":\n",
        "            precision_high,\n",
        "\n",
        "\n",
        "        \"Sensitivity\":\n",
        "            sensitivity,\n",
        "\n",
        "        \"Sensitivity CI Low\":\n",
        "            sensitivity_low,\n",
        "\n",
        "        \"Sensitivity CI High\":\n",
        "            sensitivity_high,\n",
        "\n",
        "\n",
        "        \"Specificity\":\n",
        "            specificity,\n",
        "\n",
        "        \"Specificity CI Low\":\n",
        "            specificity_low,\n",
        "\n",
        "        \"Specificity CI High\":\n",
        "            specificity_high,\n",
        "\n",
        "\n",
        "        \"F1\":\n",
        "            f1,\n",
        "\n",
        "        \"ROC-AUC\":\n",
        "            roc_auc,\n",
        "\n",
        "        \"Balanced Accuracy\":\n",
        "            balanced_accuracy,\n",
        "\n",
        "        \"MCC\":\n",
        "            mcc,\n",
        "\n",
        "\n",
        "        # ---------------- Confusion Matrix ----------------\n",
        "\n",
        "        \"TN\":\n",
        "            tn,\n",
        "\n",
        "        \"FP\":\n",
        "            fp,\n",
        "\n",
        "        \"FN\":\n",
        "            fn,\n",
        "\n",
        "        \"TP\":\n",
        "            tp\n",
        "    }\n",
        "\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 8: EVALUATE ALL MODELS\n",
        "# ============================================================\n",
        "\n",
        "model_names = [\n",
        "    \"XGBoost\",\n",
        "    \"Random Forest\",\n",
        "    \"HistGradientBoosting\",\n",
        "    \"Voting Fusion\",\n",
        "    \"Stacking Fusion\"\n",
        "]\n",
        "\n",
        "\n",
        "results = {}\n",
        "\n",
        "for name in model_names:\n",
        "\n",
        "    print(\n",
        "        \"\\n\\n################################################\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Evaluating: {name}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"################################################\"\n",
        "    )\n",
        "\n",
        "    results[name] = evaluate_model(\n",
        "        name\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 9: FINAL RESULTS DATAFRAME\n",
        "# ============================================================\n",
        "\n",
        "results_df = pd.DataFrame(\n",
        "    results\n",
        ").T\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 10: ORDER RESULTS\n",
        "# ============================================================\n",
        "\n",
        "results_df = results_df[\n",
        "    [\n",
        "\n",
        "        # ---------------- CV ----------------\n",
        "\n",
        "        \"CV Accuracy\",\n",
        "        \"CV Precision\",\n",
        "        \"CV Sensitivity\",\n",
        "        \"CV F1\",\n",
        "        \"CV ROC-AUC\",\n",
        "        \"CV Balanced Accuracy\",\n",
        "\n",
        "\n",
        "        # ---------------- Test ----------------\n",
        "\n",
        "        \"Accuracy\",\n",
        "        \"Accuracy CI Low\",\n",
        "        \"Accuracy CI High\",\n",
        "\n",
        "        \"Precision\",\n",
        "        \"Precision CI Low\",\n",
        "        \"Precision CI High\",\n",
        "\n",
        "        \"Sensitivity\",\n",
        "        \"Sensitivity CI Low\",\n",
        "        \"Sensitivity CI High\",\n",
        "\n",
        "        \"Specificity\",\n",
        "        \"Specificity CI Low\",\n",
        "        \"Specificity CI High\",\n",
        "\n",
        "        \"F1\",\n",
        "        \"ROC-AUC\",\n",
        "        \"Balanced Accuracy\",\n",
        "        \"MCC\",\n",
        "\n",
        "        # ---------------- Confusion Matrix ----------------\n",
        "\n",
        "        \"TN\",\n",
        "        \"FP\",\n",
        "        \"FN\",\n",
        "        \"TP\"\n",
        "    ]\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# STEP 11: DISPLAY FINAL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\n",
        "    \"\\n================================================\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"FINAL MODEL COMPARISON\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"================================================\\n\"\n",
        ")\n",
        "\n",
        "\n",
        "display(\n",
        "    results_df.sort_values(\n",
        "        by=\"F1\",\n",
        "        ascending=False\n",
        "    )\n",
        ")"
      ],
