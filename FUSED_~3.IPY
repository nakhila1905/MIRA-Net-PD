    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "final_meg_df = pd.read_csv('/content/drive/MyDrive/final_meg-passive(par)_top7_rfc+shap_10-fold_analysis_last_column.csv')\n",
        "\n",
        "print(\"Loaded data shape:\", final_meg_df.shape)\n",
        "print(final_meg_df.head())\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "DG8QlRKTEZ3D",
        "outputId": "250d300a-3d61-429e-dbbc-a9227eac7a3c"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Loaded data shape: (127, 8)\n",
            "   env_kurt_asym  burst_amp_cv_asym  env_kurt_R_mean  env_mod_rate_L_std  \\\n",
            "0      -0.076816           0.013925         2.510726            0.296017   \n",
            "1      -0.053170          -0.011675         2.189911            0.076190   \n",
            "2       0.073234           0.010955         1.217854            0.413152   \n",
            "3       0.077393           0.027533         1.394646            0.467633   \n",
            "4       0.022059           0.005688         1.268945            0.309523   \n",
            "\n",
            "   env_mod_rate_R_std  mean_burst_duration_R_std  env_mod_rate_R_mean  \\\n",
            "0            0.312178                   0.002180             0.421821   \n",
            "1            0.063898                   0.012065             0.208876   \n",
            "2            0.278854                   0.001874             0.462511   \n",
            "3            0.511813                   0.003089             0.637478   \n",
            "4            0.341810                   0.004726             0.295681   \n",
            "\n",
            "   PD_Label_Combined  \n",
            "0                  0  \n",
            "1                  0  \n",
            "2                  0  \n",
            "3                  1  \n",
            "4                  1  \n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "#        EARLY FUSION BASELINE (BALANCED + 32D)\n",
        "#               + 5-FOLD CROSS VALIDATION\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.model_selection import StratifiedKFold\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score\n",
        ")\n",
        "\n",
        "from imblearn.over_sampling import SMOTE\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# ============================================================\n",
        "# STEP 1 — LOAD FEATURES + LABELS\n",
        "# ============================================================\n",
        "\n",
        "# Acoustic\n",
        "X_acoustic = df_acoustic_top7.iloc[:, :-1].values.astype(np.float32)\n",
        "y_acoustic = df_acoustic_top7.iloc[:, -1].values.astype(np.int64)\n",
        "\n",
        "# MEG\n",
        "X_meg = final_meg_df.iloc[:, :-1].values.astype(np.float32)\n",
        "y_meg = final_meg_df.iloc[:, -1].values.astype(np.int64)\n",
        "\n",
        "print(\"Acoustic Shape:\", X_acoustic.shape)\n",
        "print(\"MEG Shape:\", X_meg.shape)\n",
        "\n",
        "# ============================================================\n",
        "# STEP 2 — NORMALIZATION\n",
        "# ============================================================\n",
        "\n",
        "scaler_acoustic = StandardScaler()\n",
        "scaler_meg = StandardScaler()\n",
        "\n",
        "X_acoustic = scaler_acoustic.fit_transform(X_acoustic)\n",
        "X_meg = scaler_meg.fit_transform(X_meg)\n",
        "\n",
        "# ============================================================\n",
        "# STEP 3 — COMBINE MODALITIES\n",
        "# ============================================================\n",
        "\n",
        "X_early = np.vstack([X_acoustic, X_meg]).astype(np.float32)\n",
        "\n",
        "y_early = np.hstack([\n",
        "    y_acoustic,\n",
        "    y_meg\n",
        "]).astype(np.int64)\n",
        "\n",
        "print(\"\\nCombined Shape:\", X_early.shape)\n",
        "print(\"Combined Labels:\", y_early.shape)\n",
        "\n",
        "# ============================================================\n",
        "# STEP 4 — EARLY FUSION MLP (32D LATENT)\n",
        "# ============================================================\n",
        "\n",
        "class EarlyFusionMLP(nn.Module):\n",
        "\n",
        "    def __init__(self, input_dim):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        self.feature_extractor = nn.Sequential(\n",
        "\n",
        "            nn.Linear(input_dim, 64),\n",
        "            nn.ReLU(),\n",
        "            nn.BatchNorm1d(64),\n",
        "            nn.Dropout(0.3),\n",
        "\n",
        "            nn.Linear(64, 32),\n",
        "            nn.ReLU(),\n",
        "            nn.BatchNorm1d(32)\n",
        "        )\n",
        "\n",
        "        self.classifier = nn.Sequential(\n",
        "\n",
        "            nn.Dropout(0.2),\n",
        "\n",
        "            nn.Linear(32, 2)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        latent = self.feature_extractor(x)\n",
        "\n",
        "        out = self.classifier(latent)\n",
        "\n",
        "        return out, latent\n",
        "\n",
        "# ============================================================\n",
        "# STEP 5 — CROSS VALIDATION\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" 5-FOLD CROSS VALIDATION\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "skf = StratifiedKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "accs = []\n",
        "precs = []\n",
        "recs = []\n",
        "f1s = []\n",
        "aucs = []\n",
        "\n",
        "fold = 1\n",
        "\n",
        "# ============================================================\n",
        "# STEP 6 — FOLD LOOP\n",
        "# ============================================================\n",
        "\n",
        "for train_idx, test_idx in skf.split(X_early, y_early):\n",
        "\n",
        "    X_train = X_early[train_idx]\n",
        "    X_test = X_early[test_idx]\n",
        "\n",
        "    y_train = y_early[train_idx]\n",
        "    y_test = y_early[test_idx]\n",
        "\n",
        "    # ========================================================\n",
        "    # SMOTE\n",
        "    # ========================================================\n",
        "\n",
        "    smote = SMOTE(random_state=42)\n",
        "\n",
        "    X_train, y_train = smote.fit_resample(\n",
        "        X_train,\n",
        "        y_train\n",
        "    )\n",
        "\n",
        "    # ========================================================\n",
        "    # TENSORS\n",
        "    # ========================================================\n",
        "\n",
        "    X_train = torch.tensor(X_train).float().to(device)\n",
        "    X_test = torch.tensor(X_test).float().to(device)\n",
        "\n",
        "    y_train = torch.tensor(y_train).long().to(device)\n",
        "\n",
        "    # ========================================================\n",
        "    # MODEL\n",
        "    # ========================================================\n",
        "\n",
        "    model = EarlyFusionMLP(\n",
        "        input_dim=X_early.shape[1]\n",
        "    ).to(device)\n",
        "\n",
        "    optimizer = optim.Adam(\n",
        "        model.parameters(),\n",
        "        lr=1e-3,\n",
        "        weight_decay=1e-4\n",
        "    )\n",
        "\n",
        "    criterion = nn.CrossEntropyLoss()\n",
        "\n",
        "    # ========================================================\n",
        "    # TRAINING\n",
        "    # ========================================================\n",
        "\n",
        "    epochs = 120\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "\n",
        "        model.train()\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        outputs, latent = model(X_train)\n",
        "\n",
        "        loss = criterion(outputs, y_train)\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer.step()\n",
        "\n",
        "    # ========================================================\n",
        "    # EVALUATION\n",
        "    # ========================================================\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        outputs, latent_test = model(X_test)\n",
        "\n",
        "        probs = torch.softmax(\n",
        "            outputs,\n",
        "            dim=1\n",
        "        )[:, 1].cpu().numpy()\n",
        "\n",
        "        preds = outputs.argmax(1).cpu().numpy()\n",
        "\n",
        "    # ========================================================\n",
        "    # METRICS\n",
        "    # ========================================================\n",
        "\n",
        "    acc = accuracy_score(\n",
        "        y_test,\n",
        "        preds\n",
        "    )\n",
        "\n",
        "    precision = precision_score(\n",
        "        y_test,\n",
        "        preds\n",
        "    )\n",
        "\n",
        "    recall = recall_score(\n",
        "        y_test,\n",
        "        preds\n",
        "    )\n",
        "\n",
        "    f1 = f1_score(\n",
        "        y_test,\n",
        "        preds\n",
        "    )\n",
        "\n",
        "    auc = roc_auc_score(\n",
        "        y_test,\n",
        "        probs\n",
        "    )\n",
        "\n",
        "    accs.append(acc)\n",
        "    precs.append(precision)\n",
        "    recs.append(recall)\n",
        "    f1s.append(f1)\n",
        "    aucs.append(auc)\n",
        "\n",
        "    # ========================================================\n",
        "    # PRINT FOLD RESULTS\n",
        "    # ========================================================\n",
        "\n",
        "    print(f\"Fold {fold}\")\n",
        "\n",
        "    print(f\"Accuracy  : {acc:.4f}\")\n",
        "    print(f\"Precision : {precision:.4f}\")\n",
        "    print(f\"Recall    : {recall:.4f}\")\n",
        "    print(f\"F1-Score  : {f1:.4f}\")\n",
        "    print(f\"AUC       : {auc:.4f}\")\n",
        "\n",
        "    print()\n",
        "\n",
        "    fold += 1\n",
        "\n",
        "# ============================================================\n",
        "# FINAL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" FINAL RESULTS\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "print(f\"Mean Accuracy  : {np.mean(accs)*100:.2f}%\")\n",
        "print(f\"Mean Precision : {np.mean(precs)*100:.2f}%\")\n",
        "print(f\"Mean Recall    : {np.mean(recs)*100:.2f}%\")\n",
        "print(f\"Mean F1-Score  : {np.mean(f1s)*100:.2f}%\")\n",
        "print(f\"Mean AUC       : {np.mean(aucs)*100:.2f}%\")\n",
        "\n",
        "# ============================================================\n",
        "# EXTRACT 32D FEATURES\n",
        "# ============================================================\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    acoustic_tensor = torch.tensor(\n",
        "        X_acoustic\n",
        "    ).float().to(device)\n",
        "\n",
        "    meg_tensor = torch.tensor(\n",
        "        X_meg\n",
        "    ).float().to(device)\n",
        "\n",
        "    _, acoustic_32D = model(acoustic_tensor)\n",
        "\n",
        "    _, meg_32D = model(meg_tensor)\n",
        "\n",
        "acoustic_32D = acoustic_32D.cpu().numpy()\n",
        "meg_32D = meg_32D.cpu().numpy()\n",
        "\n",
        "print(\"\\n======================================\")\n",
        "print(\" LATENT SHAPES\")\n",
        "print(\"======================================\\n\")\n",
        "\n",
        "print(\"Acoustic 32D Shape :\", acoustic_32D.shape)\n",
        "print(\"MEG 32D Shape      :\", meg_32D.shape)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "fucFefG1EZ0z",
